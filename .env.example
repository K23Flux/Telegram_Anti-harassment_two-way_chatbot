# ===== 必填 =====

# 机器人 Token，找 @BotFather 发 /newbot 获取
BOT_TOKEN=your_bot_token_here

# 管理群 ID：开启了「话题」的超级群组，以 -100 开头
# 把机器人设为群管理员后，在群里发 /getid 可以查到
FORUM_GROUP_ID=-1001234567890

# 管理员的用户 ID，多个用英文逗号分隔（私聊机器人发 /getid 可以查到）
ADMIN_IDS=123456789

# ===== 可选（以下都是默认值）=====

# 新用户第一次发消息前是否要答验证题
VERIFICATION_ENABLED=true

# 被临时封禁的用户能否答题自助解封（永久封禁的始终不能）
AUTO_UNBLOCK_ENABLED=true

# 验证题 / 解封题的有效期（秒）
VERIFICATION_TIMEOUT=300

# 验证最多答错几次，超过就临时封禁
MAX_VERIFICATION_ATTEMPTS=3

# 每人每分钟最多转发几条，超出的不转发、提醒一次，不会封人
MAX_MESSAGES_PER_MINUTE=30

# 消息处理并发数，一般不用改
MAX_WORKERS=5

# 数据库路径（容器内路径，对应宿主机的 ./data）
DATABASE_PATH=./data/bot.db
